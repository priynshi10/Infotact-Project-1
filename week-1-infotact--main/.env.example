# AetherHound Environment Configuration

# RF / RTL-SDR Configuration
AETHERHOUND_RF_CENTER_FREQ_HZ=433920000
AETHERHOUND_RF_SAMPLE_RATE_HZ=2048000
AETHERHOUND_RF_GAIN=auto
AETHERHOUND_RF_DEVICE_INDEX=0
AETHERHOUND_RF_PPM_CORRECTION=0
AETHERHOUND_RF_FFT_SIZE=2048
AETHERHOUND_RF_WINDOW_SAMPLES=16384

# Acoustic / Microphone Configuration
AETHERHOUND_AUDIO_SAMPLE_RATE_HZ=44100
AETHERHOUND_AUDIO_CHANNELS=1
AETHERHOUND_AUDIO_DEVICE_INDEX=-1
AETHERHOUND_AUDIO_CHUNK_SIZE=2048

# Anomaly Detection Parameters
AETHERHOUND_RF_SIGMA_THRESHOLD=4.5
AETHERHOUND_ACOUSTIC_ENERGY_THRESHOLD=3.0
AETHERHOUND_DETECTION_WINDOW_MS=250

# Morse Simulator & Detector Parameters
AETHERHOUND_MORSE_DOT_DURATION_SEC=0.20
AETHERHOUND_MORSE_DASH_DURATION_SEC=0.60
AETHERHOUND_MORSE_TIMING_TOLERANCE=0.35
AETHERHOUND_FAN_BASE_RPM=1200
AETHERHOUND_FAN_LOW_RPM=900
AETHERHOUND_FAN_HIGH_RPM=1800

# Storage & Logging
AETHERHOUND_DATA_DIR=data
AETHERHOUND_LOG_LEVEL=INFO
